{
  "name": "SimpleSocketProtocol",
  "version": "1.2.1",
  "description": "Simple Socket Protocol (SSP): lightweight C binary protocol for UART/serial links between embedded CPUs. Sockets, ACK/NAK, retries, CRC, fixed-block allocator, portable HAL/OSAL.",
  "keywords": [
    "serial",
    "uart",
    "protocol",
    "communication",
    "embedded",
    "c",
    "arduino"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/SimpleSocketProtocol.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/SimpleSocketProtocol",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "SimpleSocketProtocol.h",
    "ssp.h",
    "ssp_arduino.h"
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "ssp-demo",
      "base": "examples/platformio/ssp-demo",
      "files": [
        "platformio.ini",
        "src/main.cpp"
      ]
    },
    {
      "name": "ssp-device",
      "base": "examples/platformio/ssp-device",
      "files": [
        "platformio.ini",
        "src/main.cpp"
      ]
    },
    {
      "name": "SSP_Demo",
      "base": "examples/SSP_Demo",
      "files": [
        "SSP_Demo.ino"
      ]
    },
    {
      "name": "SSP_Device",
      "base": "examples/SSP_Device",
      "files": [
        "SSP_Device.ino"
      ]
    }
  ]
}
